# Resend API key — create one at https://resend.com/api-keys
# Never commit the real value; .env.local is gitignored.
RESEND_API_KEY=

# Optional. Defaults to Resend's shared sender (onboarding@resend.dev), which
# only delivers to the address that owns the Resend account. Once
# siddharthkhanna.com is verified in Resend, set this to a real address:
# MAIL_FROM=notes@siddharthkhanna.com
MAIL_FROM=
